---
---
<div class="chess-container">
    <div id="chessboard" class="chessboard"></div>
    <div class="status-panel">
        <div id="status">White to move</div>
        <button id="reset-btn">Reset Game</button>
    </div>
</div>

<script>
    import { Chess } from 'chess.js';

    let game = new Chess();
    const boardElement = document.getElementById('chessboard');
    const statusElement = document.getElementById('status');
    const resetBtn = document.getElementById('reset-btn');

    let selectedSquare = null;

    const pieceUnicode = {
        'p': '♟', 'r': '♜', 'n': '♞', 'b': '♝', 'q': '♛', 'k': '♚',
        'P': '♙', 'R': '♖', 'N': '♘', 'B': '♗', 'Q': '♕', 'K': '♔'
    };

    function createBoard() {
        if (!boardElement) return;
        boardElement.innerHTML = '';
        const board = game.board();

        for (let i = 0; i < 8; i++) {
            for (let j = 0; j < 8; j++) {
                const square = document.createElement('div');
                const squareName = String.fromCharCode(97 + j) + (8 - i);
                square.classList.add('square');
                square.classList.add((i + j) % 2 === 0 ? 'light' : 'dark');
                square.dataset.square = squareName;

                // Add coordinates
                if (j === 0) {
                    const coord = document.createElement('span');
                    coord.classList.add('coord', 'rank');
                    coord.textContent = (8 - i).toString();
                    square.appendChild(coord);
                }
                if (i === 7) {
                    const coord = document.createElement('span');
                    coord.classList.add('coord', 'file');
                    coord.textContent = String.fromCharCode(97 + j);
                    square.appendChild(coord);
                }

                const pieceContainer = document.createElement('span');
                pieceContainer.classList.add('piece');
                const piece = board[i][j];
                if (piece) {
                    pieceContainer.textContent = pieceUnicode[piece.color === 'w' ? piece.type.toUpperCase() : piece.type.toLowerCase()];
                    square.classList.add(piece.color === 'w' ? 'white-piece' : 'black-piece');
                }
                square.appendChild(pieceContainer);

                square.addEventListener('click', () => handleSquareClick(squareName));
                boardElement.appendChild(square);
            }
        }
        updateStatus();
    }

    function handleSquareClick(square) {
        if (selectedSquare === square) {
            selectedSquare = null;
            renderBoard();
            return;
        }

        if (selectedSquare) {
            try {
                const move = game.move({
                    from: selectedSquare,
                    to: square,
                    promotion: 'q' // always promote to queen for simplicity
                });

                if (move) {
                    selectedSquare = null;
                    renderBoard();
                    return;
                }
            } catch (e) {
                // Invalid move
            }
        }

        const piece = game.get(square);
        if (piece && piece.color === game.turn()) {
            selectedSquare = square;
            renderBoard();
        }
    }

    function renderBoard() {
        const squares = boardElement.querySelectorAll('.square');
        const board = game.board();
        
        squares.forEach((sq, index) => {
            const i = Math.floor(index / 8);
            const j = index % 8;
            const squareName = String.fromCharCode(97 + j) + (8 - i);
            const piece = board[i][j];
            const pieceContainer = sq.querySelector('.piece');

            if (pieceContainer) {
                pieceContainer.textContent = piece ? pieceUnicode[piece.color === 'w' ? piece.type.toUpperCase() : piece.type.toLowerCase()] : '';
            }
            
            sq.className = `square ${(i + j) % 2 === 0 ? 'light' : 'dark'}`;
            if (piece) sq.classList.add(piece.color === 'w' ? 'white-piece' : 'black-piece');
            if (selectedSquare === squareName) sq.classList.add('selected');
            
            // Highlight possible moves
            if (selectedSquare) {
                const moves = game.moves({ square: selectedSquare, verbose: true });
                if (moves.some(m => m.to === squareName)) {
                    sq.classList.add('possible-move');
                }
            }
        });
        updateStatus();
    }

    function updateStatus() {
        let status = '';
        let moveColor = game.turn() === 'w' ? 'White' : 'Black';

        if (game.isCheckmate()) {
            status = `Game over, ${moveColor} is in checkmate.`;
        } else if (game.isDraw()) {
            status = 'Game over, drawn position';
        } else {
            status = `${moveColor} to move`;
            if (game.inCheck()) {
                status += `, ${moveColor} is in check`;
            }
        }
        statusElement.textContent = status;
    }

    resetBtn.addEventListener('click', () => {
        game.reset();
        selectedSquare = null;
        renderBoard();
    });

    createBoard();
</script>

<style>
    .chess-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.05);
        padding: 1.5rem;
        border-radius: 12px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .chessboard {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(8, 1fr);
        width: 320px;
        height: 320px;
        border: 4px solid #333;
        user-select: none;
    }

    @media (min-width: 640px) {
        .chessboard {
            width: 400px;
            height: 400px;
        }
    }

    .square {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        cursor: pointer;
        position: relative;
    }

    @media (min-width: 640px) {
        .square {
            font-size: 2.5rem;
        }
    }

    .coord {
        position: absolute;
        font-size: 0.6rem;
        font-weight: bold;
        pointer-events: none;
    }

    .rank {
        top: 2px;
        left: 2px;
    }

    .file {
        bottom: 2px;
        right: 2px;
    }

    .light .coord {
        color: rgba(0, 0, 0, 0.3);
    }

    .dark .coord {
        color: rgba(255, 255, 255, 0.3);
    }

    .piece {
        z-index: 1;
    }

    .light {
        background-color: #ebecd0;
    }

    .dark {
        background-color: #779556;
    }

    .white-piece {
        color: #fff;
        text-shadow: 0 0 2px #000;
    }

    .black-piece {
        color: #000;
    }

    .selected {
        background-color: #f6f669 !important;
    }

    .possible-move::after {
        content: '';
        width: 12px;
        height: 12px;
        background-color: rgba(0, 0, 0, 0.1);
        border-radius: 50%;
        position: absolute;
    }

    .status-panel {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        color: white;
        font-family: system-ui, sans-serif;
    }

    #reset-btn {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.2s;
    }

    #reset-btn:hover {
        background: rgba(255, 255, 255, 0.2);
    }
</style>
