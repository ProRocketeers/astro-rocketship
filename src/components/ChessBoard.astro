---
---
<div class="chess-container">
    <div id="board" class="board"></div>
    <div class="game-info">
        <p id="status">White's turn</p>
        <button id="reset">Reset Game</button>
    </div>
</div>

<script>
    const boardElement = document.getElementById('board');
    const statusElement = document.getElementById('status');
    const resetBtn = document.getElementById('reset');

    const INITIAL_BOARD = [
        ['♜', '♞', '♝', '♛', '♚', '♝', '♞', '♜'],
        ['♟', '♟', '♟', '♟', '♟', '♟', '♟', '♟'],
        ['', '', '', '', '', '', '', ''],
        ['', '', '', '', '', '', '', ''],
        ['', '', '', '', '', '', '', ''],
        ['', '', '', '', '', '', '', ''],
        ['♙', '♙', '♙', '♙', '♙', '♙', '♙', '♙'],
        ['♖', '♘', '♗', '♕', '♔', '♗', '♘', '♖']
    ];

    let board = JSON.parse(JSON.stringify(INITIAL_BOARD));
    let selectedSquare = null;
    let turn = 'white';

    const WHITE_PIECES = ['♖', '♘', '♗', '♕', '♔', '♙'];
    const BLACK_PIECES = ['♜', '♞', '♝', '♛', '♚', '♟'];

    function isWhite(piece) {
        return WHITE_PIECES.includes(piece);
    }

    function isBlack(piece) {
        return BLACK_PIECES.includes(piece);
    }

    function renderBoard() {
        if (!boardElement) return;
        boardElement.innerHTML = '';
        for (let r = 0; r < 8; r++) {
            for (let c = 0; c < 8; c++) {
                const square = document.createElement('div');
                const piece = board[r][c];
                square.className = `square ${(r + c) % 2 === 0 ? 'light' : 'dark'}`;
                
                if (selectedSquare && selectedSquare.r === r && selectedSquare.c === c) {
                    square.classList.add('selected');
                }
                
                if (piece) {
                    square.classList.add(isWhite(piece) ? 'white-piece' : 'black-piece');
                }

                square.textContent = piece;
                square.dataset.r = r.toString();
                square.dataset.c = c.toString();
                square.onclick = () => handleSquareClick(r, c);
                boardElement.appendChild(square);
            }
        }
    }

    function handleSquareClick(r, c) {
        const piece = board[r][c];

        if (selectedSquare) {
            // Move piece
            if (selectedSquare.r === r && selectedSquare.c === c) {
                selectedSquare = null;
            } else {
                // Simple move logic: just move the piece
                // In a real game, you'd check if the move is legal
                board[r][c] = board[selectedSquare.r][selectedSquare.c];
                board[selectedSquare.r][selectedSquare.c] = '';
                selectedSquare = null;
                turn = turn === 'white' ? 'black' : 'white';
                if (statusElement) statusElement.textContent = `${turn.charAt(0).toUpperCase() + turn.slice(1)}'s turn`;
            }
            renderBoard();
        } else {
            // Select piece
            if (piece) {
                if ((turn === 'white' && isWhite(piece)) || (turn === 'black' && isBlack(piece))) {
                    selectedSquare = { r, c };
                    renderBoard();
                }
            }
        }
    }

    resetBtn?.addEventListener('click', () => {
        board = JSON.parse(JSON.stringify(INITIAL_BOARD));
        selectedSquare = null;
        turn = 'white';
        if (statusElement) statusElement.textContent = "White's turn";
        renderBoard();
    });

    renderBoard();
</script>

<style>
    .chess-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        backdrop-filter: blur(5px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-top: 2rem;
    }

    .board {
        display: grid;
        grid-template-columns: repeat(8, 40px);
        grid-template-rows: repeat(8, 40px);
        border: 2px solid #333;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    @media (min-width: 640px) {
        .board {
            grid-template-columns: repeat(8, 60px);
            grid-template-rows: repeat(8, 60px);
        }
    }

    .square {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        cursor: pointer;
        user-select: none;
        transition: background-color 0.2s;
    }

    @media (min-width: 640px) {
        .square {
            font-size: 3rem;
        }
    }

    .light {
        background-color: #ebecd0;
    }

    .dark {
        background-color: #779556;
    }

    .white-piece {
        color: #fff;
        text-shadow: 0 0 2px #000, 1px 1px 2px rgba(0,0,0,0.5);
    }

    .black-piece {
        color: #000;
        text-shadow: 0 0 1px #fff;
    }

    .square.selected {
        background-color: #f6f669 !important;
    }

    .square:hover {
        filter: brightness(1.1);
    }

    .game-info {
        text-align: center;
        color: white;
        font-family: system-ui, -apple-system, sans-serif;
    }

    #status {
        margin-bottom: 0.5rem;
        font-weight: bold;
    }

    button {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
        transition: transform 0.1s;
    }

    button:active {
        transform: scale(0.95);
    }
</style>
